{
  "name": "PrimalBananaIsland-Island",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "CombatClient": {
        "$path": "src/combatClient"
      }
    },
    "ServerScriptService": {
      "ServerShared": {
        "$path": "src/serverShared"
      },
      "Combat": {
        "$path": "src/combat"
      },
      "Server": {
        "$path": "src/island/server"
      }
    },
    "ServerStorage": {
      "Tools": {
        "$path": "src/island/tools"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/island/client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/island/character/Health.server.luau"
        }
      },
      "$properties": {
        "EnableMouseLockOption": true
      }
    }
  }
}
