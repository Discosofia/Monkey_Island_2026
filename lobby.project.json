{
  "name": "PrimalBananaIsland-Lobby",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "CombatClient": {
        "$path": "src/combatClient"
      }
    },
    "ServerScriptService": {
      "ServerShared": {
        "$path": "src/serverShared"
      },
      "Combat": {
        "$path": "src/combat"
      },
      "Server": {
        "$path": "src/lobby/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/lobby/client"
        }
      },
      "$properties": {
        "EnableMouseLockOption": false
      }
    }
  }
}
