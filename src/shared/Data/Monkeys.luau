--!strict
-- Especies de monos (GDD §8.2). Fase 1.4: las dos primeras de la categoría 1. Fase 2.4: capuchino ladrón.
-- Fase 4: el resto de las categorías 1 a 3, cada una con su zona y su mecánica propia.
-- Zonas ("zone"): Selva (por defecto), Basecamp (alrededores), Playa, Rios, Montanas, Volcan.
-- Las de bioma aparecen cerca de su guarida (MapBuilder: GuaridasJefes/Guarida_<zona>).
-- Para balancear, cambia los números aquí. Las distancias están en studs.

export type LootEntry = {
	itemId: string, -- ver Data/Items
	chance: number, -- 0 a 1
	min: number,
	max: number,
}

export type MonkeyDefinition = {
	name: string,
	description: string, -- lo que cuenta el diario de campo
	tier: number,
	zone: string?,
	activeAt: "Day" | "Night" | "Both", -- cuándo aparece en la isla
	groups: number, -- grupos repartidos por la isla
	groupMin: number,
	groupMax: number,
	maxHealth: number,
	walkSpeed: number,
	damage: number,
	attackCooldownSeconds: number,
	attackRange: number,
	aggroRange: number, -- a qué distancia te detecta
	leashRange: number, -- cuánto se aleja de su zona antes de rendirse y volver
	fleeHealthFraction: number?, -- huye cuando le queda menos de esta fracción de vida
	howl: boolean?, -- aúlla al detectarte: avisa a los monos cercanos y llama refuerzos
	thief: number?, -- en vez de morder, roba hasta esta cantidad de un material y huye con él
	thiefFoodOnly: boolean?, -- solo roba comida
	fearsFire: boolean?, -- se aparta de antorchas (en la mano o de pie) y hogueras
	ignoresTorchBearers: boolean?, -- no ataca a quien lleva una antorcha en la mano
	pounce: boolean?, -- salta sobre su presa desde lejos; el primer golpe tras el salto hace el doble
	alpha: boolean?, -- el grupo tiene un alfa (más vida y daño); si muere, la tropa huye
	roar: { radius: number, seconds: number }?, -- rugido: quien lo oye hace menos daño un rato
	throws: { range: number, damage: number, cooldownSeconds: number }?, -- lanza piedras
	grab: number?, -- su golpe inmoviliza tantos segundos
	stomp: { radius: number, damage: number, stunSeconds: number, cooldownSeconds: number }?, -- golpe en área
	disarmsTraps: boolean?, -- en el asedio, va primero a por las estacas y no le hacen daño
	voice: "Small" | "Medium" | "Large", -- grupo de sonidos por tamaño (Data/Sounds: MonkeyVoices)
	scale: number, -- tamaño del modelo; franja de alto por categoría en GDD §8.2 "Tamaño estándar"
	bodyColor: Color3,
	faceColor: Color3,
	loot: { LootEntry },
}

